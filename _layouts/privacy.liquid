<!doctype html>
<html lang="{{ site.lang | default: 'en' }}" data-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Privacy and optional analytics on Miguel Del Valle's website.">
    <title>
      {{ page.title | escape }}
      ·
      {{ site.title | escape }}
    </title>
    <link rel="canonical" href="{{ site.url }}{{ page.url | relative_url }}">
    <link rel="icon" href="{{ '/assets/img/favicon.svg' | relative_url }}" type="image/svg+xml">
    <link rel="stylesheet" href="{{ '/assets/css/personal.css' | relative_url }}">
  </head>
  <body>
    <main class="privacy-page section-shell section-shell--narrow">
      <p><a href="{{ '/' | relative_url }}">← Back to home</a></p>
      {{ content }}
      <button type="button" class="privacy-page__settings" data-analytics-settings>Change analytics choice</button>
    </main>
    {% include analytics-consent.liquid %}
    <script src="{{ '/assets/js/analytics-consent.js' | relative_url }}" data-measurement-id="{{ site.google_analytics }}" defer></script>
  </body>
</html>
