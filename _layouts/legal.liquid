<!doctype html>
<html lang="{{ site.lang | default: 'en' }}" data-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ page.description | default: site.description | strip_html | normalize_whitespace | escape }}">
    <meta name="theme-color" content="#143f3e">
    <title>
      {{ page.title | escape }}
      ·
      {{ site.title | escape }}
    </title>
    <link rel="canonical" href="{{ site.url }}{{ page.url | relative_url }}">
    <link rel="icon" href="{{ '/assets/img/favicon.svg' | relative_url }}" type="image/svg+xml">
    <link rel="stylesheet" href="{{ '/assets/css/personal.css' | relative_url }}">
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="legal-header">
      <div class="section-shell section-shell--narrow legal-header__inner">
        <a class="wordmark" href="{{ '/' | relative_url }}">Miguel Del Valle</a>
        <a href="{{ '/' | relative_url }}">Home</a>
      </div>
    </header>
    <main id="main-content" class="legal-page section-shell section-shell--narrow">
      {{ content }}
      {% if page.show_analytics_settings %}
        <button type="button" class="legal-page__settings" data-analytics-settings>Change analytics choice</button>
      {% endif %}
    </main>
    <footer class="site-footer">
      <div class="section-shell section-shell--narrow">
        <span
          >© {{ 'now' | date: '%Y' }}
          {{ site.data.profile.name -}}
        </span>
        <div class="site-footer__links">{% include legal-links.liquid %}</div>
      </div>
    </footer>
    {% include analytics-consent.liquid %}
    <script src="{{ '/assets/js/personal.js' | relative_url }}" defer></script>
    <script src="{{ '/assets/js/analytics-consent.js' | relative_url }}" data-measurement-id="{{ site.google_analytics }}" defer></script>
  </body>
</html>
