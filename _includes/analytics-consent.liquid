<aside class="analytics-consent" data-analytics-consent hidden aria-label="Analytics choice">
  <div class="analytics-consent__content">
    <p>
      <strong>Optional analytics.</strong> With your permission, Google Analytics helps us understand visits to this site. No analytics tag loads
      unless you accept. <a href="{{ '/privacy/' | relative_url }}">Privacy details</a>.
    </p>
    <div class="analytics-consent__actions">
      <button type="button" data-analytics-decline>Decline</button>
      <button type="button" data-analytics-accept>Accept analytics</button>
    </div>
  </div>
</aside>
